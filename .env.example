# Brand & Boost - omgevingsvariabelen
# Kopieer dit bestand naar `.env` en vul de waarden in:  cp .env.example .env
# Zet dezelfde variabelen ook in de Netlify UI (Site settings > Environment
# variables). De oude namen VITE_WEB3FORMS_KEY en VITE_GA4_ID blijven ook
# werken, dus de bestaande Netlify-configuratie hoeft niet aangepast.

# Web3Forms access key (formulieren -> info@brandandboost.nl)
WEB3FORMS_KEY=

# Google Analytics 4 meet-ID (formaat G-XXXXXXXXXX). Leeg = geen meting.
GA4_ID=
