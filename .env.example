# Brand & Boost — omgevingsvariabelen
#
# Kopieer dit bestand naar `.env` en vul de waarde in.
#   cp .env.example .env
#
# TODO: haal een gratis access key op via https://web3forms.com
# (koppel hem aan info@brandandboost.nl) en plak hem hieronder.
# Het contactformulier werkt pas zodra deze key is ingevuld.
VITE_WEB3FORMS_KEY=

# Google Analytics 4 meet-ID (formaat G-XXXXXXXXXX). Zet deze ook als
# environment variable in de Netlify UI (Site settings > Environment
# variables), want dit is een build-time variabele. Zonder ID wordt er
# geen enkel meetscript geladen.
VITE_GA4_ID=
